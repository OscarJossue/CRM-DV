# Local development only. Copy to .env and replace values as needed.
DEBUG=True
SECRET_KEY=change-this-local-secret-key
INTEGRATION_ENCRYPTION_KEY=change-this-local-integration-key
CREDENTIAL_ENCRYPTION_KEY=change-this-local-smtp-credential-key
JWT_SIGNING_KEY=change-this-local-jwt-signing-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CRM_PUBLIC_BASE_URL=http://localhost:8000

POSTGRES_DB=crm_saas
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=change-local-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
CACHE_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
TIME_ZONE=America/Guayaquil

PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILURES=8
LOGIN_MAX_FAILURES_PER_IP=40
LOGIN_FAILURE_WINDOW_SECONDS=900
JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=7

PLATFORM_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_TIMEOUT=20

# Development demo data is opt-in. Passwords are never hardcoded in source.
AUTO_SEED=False
# DEMO_PLATFORM_ADMIN_PASSWORD=generate-a-strong-local-password
# DEMO_COMPANY_OWNER_PASSWORD=generate-a-different-local-password
# DEMO_SECRETARY_PASSWORD=generate-a-different-local-password
# DEMO_INSPECTOR_PASSWORD=generate-a-different-local-password

# CRM history retention
AUDIT_LOG_RETENTION_DAYS=3
AUDIT_CRITICAL_RETENTION_DAYS=7
