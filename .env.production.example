# Copy to .env.production. Never commit the real file.
DEBUG=False
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_A_SEPARATE_FERNET_OR_RANDOM_KEY
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_A_FOURTH_SEPARATE_FERNET_OR_RANDOM_KEY
JWT_SIGNING_KEY=REPLACE_WITH_A_THIRD_SEPARATE_RANDOM_KEY
ALLOWED_HOSTS=crm.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://crm.yourdomain.com
CORS_ALLOWED_ORIGINS=https://crm.yourdomain.com
CRM_PUBLIC_BASE_URL=https://crm.yourdomain.com

POSTGRES_DB=crm_saas
POSTGRES_USER=crm_prod
POSTGRES_PASSWORD=GENERATE_A_STRONG_DATABASE_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

REDIS_PASSWORD=GENERATE_A_STRONG_REDIS_PASSWORD
CACHE_URL=redis://:GENERATE_A_STRONG_REDIS_PASSWORD@redis:6379/2
CELERY_BROKER_URL=redis://:GENERATE_A_STRONG_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:GENERATE_A_STRONG_REDIS_PASSWORD@redis:6379/1

TIME_ZONE=America/Guayaquil
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILURES=8
LOGIN_MAX_FAILURES_PER_IP=40
LOGIN_FAILURE_WINDOW_SECONDS=900
JWT_ACCESS_HOURS=2
JWT_REFRESH_DAYS=7
SESSION_COOKIE_AGE=43200

TRUST_PROXY_HEADERS=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

AUTO_MIGRATE=True
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

PLATFORM_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
PLATFORM_EMAIL_HOST=smtp.example.com
PLATFORM_EMAIL_PORT=587
PLATFORM_EMAIL_HOST_USER=noreply@example.com
PLATFORM_EMAIL_HOST_PASSWORD=CHANGE_ME
PLATFORM_EMAIL_USE_TLS=True
PLATFORM_EMAIL_USE_SSL=False
PLATFORM_DEFAULT_FROM_EMAIL=CEO Marketing CRM <noreply@example.com>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=CEO Marketing CRM <noreply@example.com>
EMAIL_TIMEOUT=20

# CRM history retention
AUDIT_LOG_RETENTION_DAYS=3
AUDIT_CRITICAL_RETENTION_DAYS=7
